erDiagram
    PROVEEDORES ||--o{ PRODUCTOS : "provee"
    PRODUCTOS ||--o{ VENTA_DETALLES : "se vende en"
    VENTAS ||--o{ VENTA_DETALLES : "contiene"

    PROVEEDORES {
        int Id PK
        nvarchar Nombre
        nvarchar Cuit UK
        nvarchar Telefono
        nvarchar Email
        nvarchar Direccion
        bit Activo
    }

    PRODUCTOS {
        int Id PK
        nvarchar Nombre
        nvarchar Descripcion
        decimal Precio
        int Stock
        int StockMinimo
        bit Activo
        int ProveedorId FK
    }

    VENTAS {
        int Id PK
        datetime Fecha
        nvarchar ClienteNombre
        decimal Total
        int Estado
    }

    VENTA_DETALLES {
        int Id PK
        int VentaId FK
        int ProductoId FK
        int Cantidad
        decimal PrecioUnitario
    }
